# Compose 지원 서비스 전체(Helm의 full과 다르다: Sync·Feedback·Collab Gateway는 Helm만) 프리셋. synctx.env.example에서 SYNCTX_SERVICES만 바꾼 완성본이다.
# 사용법: cp deploy/docker/profiles/all-supported.env deploy/docker/synctx.env 후 이미지 태그·주소를 채운다.
# synctx Docker Compose 옵션. synctx.env로 복사해서 쓴다(git 제외).
# KEY=value 형식이고 상대 경로는 deploy/docker 기준이다.
# deploy.sh가 bash로 source하고 docker compose도 읽으므로 공백이 든 값은 큰따옴표로 감싼다.

# 켤 서비스(쉼표 구분): viewer, cdn, marp, slides, drawio
# 예: Viewer·Marp·Slides만 → viewer,cdn,marp,slides / Draw.io 추가 → viewer,cdn,marp,slides,drawio
# 내부망 CDN이 이미 있으면 cdn을 빼고 .synctx.yaml의 viewer.cdn_base_url을 그 CDN 절대 주소로 둔다.
SYNCTX_SERVICES=viewer,cdn,marp,slides,drawio

# 이미지: <접두사><이름>:<태그>. 태그는 0.7.0-<git-sha> 형식이고 latest는 쓸 수 없다.
SYNCTX_IMAGE_PREFIX=registry.local:5000/
SYNCTX_IMAGE_TAG=0.7.0-0000000

# 모든 서비스가 읽는 .synctx.yaml. 인증 프록시가 없으면 authz.enabled: false로 둔다.
SYNCTX_CONFIG_FILE=./synctx.yaml

# 렌더 키는 secrets.env의 직접 값 또는 아래 파일 경로로 전달한다(동시 지정 금지).
# openssl rand -base64 32로 생성하며 복수 인스턴스는 같은 키를 공유한다.
# SYNCTX_RENDER_SECRET_FILE=
# SYNCTX_RENDER_SECRET_PREVIOUS_FILE=

# Slides 게시 저장소(slides를 켤 때 필수)
SYNCTX_SLIDES_REPO_URL=https://gitlab.internal/team/published-slides.git
SYNCTX_SLIDES_BRANCH=main
SYNCTX_SLIDES_POLL_SECONDS=60

# 게이트웨이 포트
SYNCTX_BIND_ADDRESS=0.0.0.0
SYNCTX_HTTP_PORT=80
SYNCTX_HTTPS_PORT=443

# TLS(선택): SYNCTX_TLS_DIR 아래 파일 이름. 둘 다 주면 443을 열고 80은 443으로 돌린다.
SYNCTX_TLS_DIR=./tls
SYNCTX_TLS_CERT=
SYNCTX_TLS_KEY=

# 앞단 인증 프록시가 X-Forwarded-User/Email/Groups를 넣어 줄 때만 true.
# true면 SYNCTX_TRUSTED_PROXY_CIDRS(쉼표 구분)에 든 출발지만 받고 나머지는 403이다.
# 신뢰 모드에서는 SYNCTX_BIND_ADDRESS를 0.0.0.0으로 둘 수 없다. 게이트웨이 포트는 인증 프록시만 닿아야 한다.
#  - 프록시가 다른 호스트: 프록시 쪽 인터페이스 IP에 바인딩하고 프록시 IP만 허용, 방화벽(DOCKER-USER)으로 그 밖을 막는다.
#  - 프록시가 compose 컨테이너: SYNCTX_EXTRA_COMPOSE_FILES 오버라이드로 네트워크 대역과 프록시 ipv4_address를
#    고정하고 그 주소만 허용한다.
# 접근 로그의 출발지가 Docker 브리지 게이트웨이(예: 172.18.0.1)이면 허용하지 않는다. 같은 호스트의 모든
# 프로세스가 그 주소로 보여 위조 헤더가 통과한다. 자세한 예는 docs/production-service-design.md 3.1.1.
SYNCTX_TRUSTED_AUTH_PROXY=false
SYNCTX_TRUSTED_PROXY_CIDRS=

# Marp 경로의 게이트웨이 응답 대기 시간(초). Marp 변환 제한(기본 120초)보다 길게 둔다.
SYNCTX_MARP_PROXY_TIMEOUT=180

# 사내 사정에 맞춘 compose 오버라이드 파일(선택, 공백 구분). 여러 개면 큰따옴표로 감싼다.
# 예: SYNCTX_EXTRA_COMPOSE_FILES="proxy.override.yaml volumes.override.yaml"
SYNCTX_EXTRA_COMPOSE_FILES=

SYNCTX_JITSI=false
SYNCTX_JITSI_HOST=meet.synctx.local
SYNCTX_JITSI_PUBLIC_URL=https://meet.synctx.local
SYNCTX_JITSI_APP_ID=synctx
SYNCTX_JITSI_ADVERTISE_IPS=
# 이미지 태그 기본값 stable-9823은 helm/synctx/values.yaml의 jitsi.imageTag에서 읽는다.
# Docker Hub 실존·아키텍처 미확인, 반입 전 `docker manifest inspect`
