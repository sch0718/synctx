# synctx Docker Compose 시크릿. secrets.env로 복사해서 쓴다(git 제외, 권한 600 권장).
GIT_READ_TOKEN=
# Marp 출판 저장소 push용. 비우면 Marp가 GIT_READ_TOKEN으로 대신 출판하고 경고 로그를 남긴다.
GIT_PUBLISH_TOKEN=

# 렌더 키: openssl rand -base64 32. 복수 인스턴스는 현재·이전 키를 공유한다.
# 파일 경로는 synctx.env의 _FILE로 지정한다. 같은 키의 직접 값과 함께 쓰지 않는다.
# 미지정 시 단일 인스턴스용 무작위 키를 쓰며 재시작 후 화면 새로 고침이 필요하다.
# SYNCTX_RENDER_SECRET=
# SYNCTX_RENDER_SECRET_PREVIOUS=

# collab.jitsi.enabled=true일 때 서로 다른 32바이트 이상 키. 직접 값과 _FILE은 동시 지정 금지.
# JITSI_APP_SECRET_FILE=./secrets/jitsi-app
# JITSI_APP_SECRET_PREVIOUS_FILE=./secrets/jitsi-app-previous
# JITSI_ROOM_SECRET_FILE=./secrets/jitsi-room
# JITSI_ROOM_SECRET_PREVIOUS_FILE=./secrets/jitsi-room-previous
# JITSI_JICOFO_PASSWORD=
# JITSI_JVB_PASSWORD=
